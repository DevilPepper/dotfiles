#!/usr/bin/env bash

function usage() {
  echo "Usage: claudia [attach|stop]"
}

if [[ $# -gt 1 ]]; then
  usage >&2
  exit 1
fi

case "$1" in
  attach | stop | "")
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac

agents=$(\
  gum spin --title="Assembling agents..." -- \
    claude agents --json \
    | jq -r 'map(select(.kind == "background"))' \
)

if [[ "$1" == "attach" ]]; then
  choice=$( \
    echo "$agents" \
    | jq -r '.[] | [.id, .cwd, .name] | @tsv' \
    | fzf --ansi \
          --no-multi \
          --delimiter='\t' \
          --accept-nth=1 \
          --preview='echo "$(claude logs {1})" | tr "\r" "\n"' \
  )
  if [[ -n "$choice" ]]; then
    claude attach "$choice"
  fi
elif [[ "$1" == "stop" ]]; then
  choices=($( \
    echo "$agents" \
    | jq -r '.[] | [.id, .cwd, .name] | @tsv' \
    | fzf --ansi \
          --delimiter='\t' \
          --accept-nth=1 \
          --preview='echo "$(claude logs {1})" | tr "\r" "\n"' \
  ))
  for choice in "${choices[@]}"; do
    claude stop "$choice"
  done
else
  for d in */; do
    d="${d%/}"
    count=$( \
      echo "$agents" \
      | jq --arg dir "$PWD/$d" \
          '[.[] | select(.cwd == $dir)] | length' \
    )
    if [[ "$count" -gt 0 ]]; then
      printf '(\e[32m%s\e[0m) %s\n' "$count" "$d"
    fi
  done

  choices=($(ls -d */ | tr -d '/' | gum filter --height=10 --no-limit))

  for choice in "${choices[@]}"; do
    (cd "$choice" && claude --bg)
  done

  id=$( \
    echo "$agents" \
    | jq -r --arg pwd "$PWD" '.[] | select(.cwd == $pwd) | .id' \
    | head -n1 \
  )
  if [[ -n "$id" ]]; then
    claude attach "$id"
  else
    claude
  fi
fi
